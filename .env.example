# Supabase Configuration
# Fill these values into your Vercel Project Settings > Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key_here
SUPABASE_STORAGE_BUCKET=portfolio-media
